#!/usr/bin/env python3
"""Run the dotfiles CLI from the reviewed checkout."""

import os
from pathlib import Path
import sys


script = Path({{ .chezmoi.sourceDir | toJson }}) / ".." / "scripts" / "dotfiles.py"
if not script.is_file():
    raise SystemExit("Dotfiles checkout is unavailable; reapply dotfiles from your current checkout.")
os.execv(sys.executable, [sys.executable, str(script), *sys.argv[1:]])
