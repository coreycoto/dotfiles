#!/usr/bin/env python3
"""Report global Mise selections without launching tools or installing updates."""

import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tomllib


def metadata(*args, offline):
    env = {**os.environ, "MISE_OFFLINE": "1" if offline else "0",
           "MISE_AUTO_INSTALL": "false", "MISE_EXEC_AUTO_INSTALL": "false",
           "MISE_NOT_FOUND_AUTO_INSTALL": "false"}
    result = subprocess.run(["mise", "--cd", str(Path.home()), *args],
                            capture_output=True, text=True, check=True,
                            timeout=45, env=env)
    if result.stderr.strip():
        raise ValueError("Mise metadata warning")
    value = json.loads(result.stdout)
    if not isinstance(value, dict):
        raise ValueError("Invalid Mise metadata")
    return value


def version(value):
    if not isinstance(value, str) or not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9.+_-]*", value):
        raise ValueError("Invalid tool version")
    return value


def main():
    if sys.argv[1:] not in ([], ["--updates"]):
        raise SystemExit("Usage: dotfiles-mise-status [--updates]")
    config = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
    tools = tomllib.loads((config / "mise/config.toml").read_text())["tools"]
    installed = metadata("ls", "--current", "--json", offline=True)
    updates, available = {}, False
    if "--updates" in sys.argv:
        try:
            updates = metadata("outdated", "--global", "--json", offline=False)
            for item in updates.values():
                version(item["latest"])
            available = True
        except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
            pass
    for name, request in tools.items():
        alias = name.split(":", 1)[-1]
        label = alias.rsplit("/", 1)[-1]
        wanted = request if isinstance(request, str) else request["version"]
        if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9:_/-]*", label.replace(" ", "")):
            raise ValueError("Invalid tool label")
        entries = installed.get(name, installed.get(alias, []))
        current = next((entry for entry in entries if entry.get("installed") and entry.get("active")), None)
        if current is None:
            print(f"  {label:<13} not installed or version unavailable (desired: {wanted})")
            continue
        value = version(current["version"])
        notice = ""
        if "--updates" in sys.argv:
            update = updates.get(name, updates.get(alias))
            if not available:
                notice = " (update check unavailable)"
            elif update:
                notice = f" (update available: v{version(update['latest'])})"
        print(f"  {label:<13} v{value}{notice}")


if __name__ == "__main__":
    main()
