#!/usr/bin/env python3
"""Run Mise maintenance from the reviewed dotfiles checkout."""

import os
from pathlib import Path
import sys


script = Path({{ .chezmoi.sourceDir | toJson }}) / ".." / "scripts" / "mise-tools.py"
if not script.is_file():
    raise SystemExit("Dotfiles checkout is unavailable; reapply dotfiles-tools from your current checkout.")
os.execv(sys.executable, [sys.executable, str(script), *sys.argv[1:]])
