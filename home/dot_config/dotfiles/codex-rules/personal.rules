# Staged policy only: this directory is not an active Codex rules layer.
# Personal escalation boundaries; ordinary maintenance uses the host policy.

prefix_rule(
    pattern = [
        [
            "agent-browser",
            "~/.bun/bin/agent-browser",
            "/Users/coreycoto/.bun/bin/agent-browser",
        ],
        "set",
        "credentials",
    ],
    decision = "prompt",
    justification = "Credentials are sensitive; require explicit approval.",
    match = [
        "agent-browser set credentials \"user\" \"pass\"",
    ],
)

prefix_rule(
    pattern = [
        [
            "agent-browser",
            "~/.bun/bin/agent-browser",
            "/Users/coreycoto/.bun/bin/agent-browser",
        ],
        "upload",
    ],
    decision = "prompt",
    justification = "File uploads can transfer local data; require explicit approval.",
    match = [
        "agent-browser upload \"input[type=file]\" ./tmp/file.png",
    ],
)

prefix_rule(
    pattern = [
        [
            "agent-browser",
            "~/.bun/bin/agent-browser",
            "/Users/coreycoto/.bun/bin/agent-browser",
        ],
        "connect",
    ],
    decision = "prompt",
    justification = "Connecting to a remote browser via CDP can expose external contexts; require approval.",
    match = [
        "agent-browser connect 9222",
        "agent-browser connect http://localhost:9222",
    ],
)

prefix_rule(
    pattern = [
        [
            "agent-browser",
            "~/.bun/bin/agent-browser",
            "/Users/coreycoto/.bun/bin/agent-browser",
        ],
        ["--cdp", "--headers", "--extension", "--executable-path"],
    ],
    decision = "prompt",
    justification = "Sensitive global options (CDP attach/auth headers/extensions/custom executable) require explicit approval.",
    match = [
        "agent-browser --cdp 9222 snapshot",
        "agent-browser --headers '{\"Authorization\":\"Bearer TOKEN\"}' open https://example.com",
        "agent-browser --extension ./my-extension open http://localhost:3000",
        "agent-browser --executable-path /opt/chromium open https://example.com",
    ],
)

prefix_rule(
    pattern = ["gh", "auth", "login"],
    decision = "prompt",
    justification = "Auth changes require explicit approval.",
    match = [
        "gh auth login",
    ],
)

prefix_rule(
    pattern = ["gh", "repo", "delete"],
    decision = "forbidden",
    justification = "Never delete repositories via Codex.",
    match = [
        "gh repo delete coreycoto/coreycoto.com",
    ],
)

prefix_rule(
    pattern = ["gh", "release", ["delete", "edit"]],
    decision = "forbidden",
    justification = "Do not edit or delete releases via Codex. Perform manually if needed.",
    match = [
        "gh release delete v1.2.3",
        "gh release edit v1.2.3",
    ],
)

prefix_rule(
    pattern = ["gh", "release", "create"],
    decision = "prompt",
    justification = "Release creation, including drafts, requires explicit approval of the repository, tag and publication stage.",
    match = [
        "gh release create v1.2.3",
        "gh release create v0.7.0 --draft --repo coreycoto/agent-plugins --verify-tag",
    ],
)

prefix_rule(
    pattern = ["git", ["reset", "clean", "push", "tag"]],
    decision = "prompt",
    justification = "Destructive history/worktree changes and remote publication require approval.",
    match = [
        "git reset --soft HEAD~1",
        "git clean -fd",
        "git push",
        "git tag v1.2.3",
    ],
)

prefix_rule(
    pattern = ["uv", "publish"],
    decision = "prompt",
    justification = "Package publication requires explicit approval of the intended destination and version.",
    match = [
        "uv publish",
    ],
)
